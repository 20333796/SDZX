# Copy this file to .env before starting Docker Compose. Do not commit real credentials.
POSTGRES_DB=geology_ai
POSTGRES_USER=geology_ai
POSTGRES_PASSWORD=replace-with-a-local-postgres-password

# Local development fallback. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./var/geology_ai.db

MINIO_ROOT_USER=local-minio
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
OBJECT_STORAGE_BUCKET=knowledge-documents

API_CORS_ORIGINS=http://localhost:8080
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles
# GeoChat is the local identity source until campus OIDC is configured.
GEOCHAT_AUTH_BRIDGE_URL=http://host.docker.internal:5050

# Leave both values empty unless an approved campus Ollama service is available.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Required only to enable vector indexing and semantic retrieval.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# GeoChat is served through the platform's same-origin /geochat/ gateway.
VITE_GEOCHAT_WEB_URL=/geochat

# Optional: GeoChat administrator used by the one-time knowledge importer.
GEOCHAT_IMPORT_USER_ID=1

# Optional container-image overrides for networks that require an approved registry mirror.
# Keep the official defaults above when Docker Hub is available.
PORTAL_POSTGRES_IMAGE=pgvector/pgvector:pg16
PORTAL_REDIS_IMAGE=redis:7-alpine
PORTAL_MINIO_IMAGE=minio/minio:RELEASE.2023-03-20T20-16-18Z
PORTAL_MINIO_API_PORT=9100
PORTAL_MINIO_CONSOLE_PORT=9101
